# StudyGapRadar Environment Variables

# Backend API Configuration
PROJECT_NAME="StudyGapRadar API"
VERSION="1.0.0"
API_PREFIX="/api"
SECRET_KEY="change-me-to-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite)
DATABASE_URL="sqlite:///./studygapradar.db"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# OpenAI API Key (Optional: Server-side only; domain engine fallback used if omitted)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Frontend Vite API URL (Optional, defaults to http://localhost:8000/api)
VITE_API_URL="http://localhost:8000/api"
